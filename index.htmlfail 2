<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - CreatorOS</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0a0a; color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .auth-container { width: 100%; max-width: 420px; padding: 40px; }
    .logo { text-align: center; font-size: 28px; font-weight: bold; margin-bottom: 40px; }
    .logo span { color: #d4a853; }
    .tabs { display: flex; margin-bottom: 30px; border-bottom: 1px solid #222; }
    .tab { flex: 1; padding: 16px; text-align: center; cursor: pointer; color: #666; border-bottom: 2px solid transparent; transition: all 0.3s; }
    .tab.active { color: #fff; border-bottom-color: #d4a853; }
    .form { display: none; }
    .form.active { display: block; }
    .input-group { margin-bottom: 20px; }
    .input-group label { display: block; margin-bottom: 8px; color: #888; font-size: 14px; }
    .input-group input { width: 100%; padding: 14px 16px; background: #111; border: 1px solid #333; border-radius: 8px; color: #fff; font-size: 16px; transition: border-color 0.3s; }
    .input-group input:focus { outline: none; border-color: #d4a853; }
    .btn { width: 100%; padding: 16px; background: #d4a853; color: #000; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; }
    .btn:hover { background: #f5e0b3; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .message { font-size: 14px; margin-top: 12px; text-align: center; }
    .error { color: #ff4444; }
    .success { color: #00c853; }
    .back-link { text-align: center; margin-top: 24px; }
    .back-link a { color: #666; text-decoration: none; font-size: 14px; }
    .back-link a:hover { color: #fff; }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="logo">Creator<span>OS</span></div>
    
    <div class="tabs">
      <div class="tab active" onclick="switchTab('login')">Log In</div>
      <div class="tab" onclick="switchTab('signup')">Sign Up</div>
    </div>

    <form class="form active" id="login-form" onsubmit="handleLogin(event)">
      <div class="input-group">
        <label>Email</label>
        <input type="email" id="login-email" placeholder="you@example.com" required>
      </div>
      <div class="input-group">
        <label>Password</label>
        <input type="password" id="login-password" placeholder="Your password" required>
      </div>
      <button type="submit" class="btn" id="login-btn">Log In</button>
      <div id="login-message" class="message"></div>
    </form>

    <form class="form" id="signup-form" onsubmit="handleSignup(event)">
      <div class="input-group">
        <label>Full Name</label>
        <input type="text" id="signup-name" placeholder="Your name" required>
      </div>
      <div class="input-group">
        <label>Email</label>
        <input type="email" id="signup-email" placeholder="you@example.com" required>
      </div>
      <div class="input-group">
        <label>Password</label>
        <input type="password" id="signup-password" placeholder="Min 6 characters" required minlength="6">
      </div>
      <button type="submit" class="btn" id="signup-btn">Create Free Account</button>
      <div id="signup-message" class="message"></div>
    </form>

    <div class="back-link">
      <a href="/">← Back to home</a>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.form').forEach(f => f.classList.remove('active'));
      event.target.classList.add('active');
      document.getElementById(tab + '-form').classList.add('active');
    }

    function handleLogin(e) {
      e.preventDefault();
      const msg = document.getElementById('login-message');
      msg.className = 'message success';
      msg.textContent = 'Demo: Login successful! (No backend configured yet)';
      setTimeout(() => {
        window.location.href = 'dashboard.html';
      }, 1000);
    }

    function handleSignup(e) {
      e.preventDefault();
      const msg = document.getElementById('signup-message');
      msg.className = 'message success';
      msg.textContent = 'Demo: Account created! Redirecting...';
      setTimeout(() => {
        window.location.href = 'dashboard.html';
      }, 1000);
    }
  </script>
</body>
</html>
